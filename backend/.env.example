# Copy this file to .env for local development and replace the placeholders.
# Never commit real credentials.
NODE_ENV=development
PORT=4000

# PostgreSQL connection for the NestJS API and TypeORM migrations.
# Paste the connection string from Neon; keep the real value in .env only.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Create a separate Neon branch from the Neon console and copy its connection URL.
# Isolation is checked against DATABASE_URL when available. For a deployment that
# must not receive production credentials, compare against this non-secret hostname.
# The staging datasource rejects the same endpoint, including its pooler hostname,
# and has no fallback to DATABASE_URL. Never put the production URL here.
# STAGING_DATABASE_URL=postgresql://USER:PASSWORD@STAGING_HOST/DBNAME?sslmode=require
# Optional, distinct Neon backup branch used only by database:check:backup.
# Its endpoint must differ from both staging and production.
# STAGING_BACKUP_DATABASE_URL=postgresql://USER:PASSWORD@BACKUP_HOST/DBNAME?sslmode=require
# PRODUCTION_NEON_ENDPOINT=ep-production.region.aws.neon.tech

# Authentication secrets: use randomly generated values of at least 32 characters.
JWT_ACCESS_SECRET=replace_with_a_random_secret_at_least_32_characters
OTP_HASH_SECRET=replace_with_a_different_random_secret_at_least_32_characters

# Telegram Login OIDC client ID from @BotFather Login Widget settings.
# Telegram login returns a safe service-unavailable response until configured.
TELEGRAM_CLIENT_ID=replace_with_telegram_login_client_id
# Development-only code-flow probe. Keep the secret only in backend environment.
# TELEGRAM_CLIENT_SECRET=replace_with_telegram_login_client_secret
# TELEGRAM_OIDC_PROBE_ENABLED=true
# TELEGRAM_OIDC_PROBE_REDIRECT_URI=https://api.example.com/api/auth/telegram/oidc-probe/callback

# Cloudflare Stream credentials. Video upload and playback endpoints return
# service unavailable until the real account values are configured.
CLOUDFLARE_ACCOUNT_ID=replace_with_cloudflare_account_id
CLOUDFLARE_STREAM_API_TOKEN=replace_with_cloudflare_stream_api_token
CLOUDFLARE_STREAM_CUSTOMER_CODE=replace_with_stream_customer_code
CLOUDFLARE_WEBHOOK_SECRET=replace_with_cloudflare_stream_webhook_secret

# Staging uses only these values when NODE_ENV=staging. Never copy production
# credentials here. Missing staging credentials fail closed without fallback.
# STAGING_CLOUDFLARE_ACCOUNT_ID=replace_with_staging_cloudflare_account_id
# STAGING_CLOUDFLARE_STREAM_API_TOKEN=replace_with_staging_stream_api_token
# STAGING_CLOUDFLARE_STREAM_CUSTOMER_CODE=replace_with_staging_stream_customer_code
# STAGING_CLOUDFLARE_WEBHOOK_SECRET=replace_with_staging_stream_webhook_secret

# Payme Merchant API credentials and checkout configuration.
PAYME_MERCHANT_ID=replace_with_payme_merchant_id
PAYME_MERCHANT_PASSWORD=replace_with_payme_merchant_password
PAYME_RETURN_URL=https://example.invalid/payment-return

# Click Shop API credentials from the merchant portal.
CLICK_SERVICE_ID=replace_with_click_service_id
CLICK_MERCHANT_ID=replace_with_click_merchant_id
CLICK_SECRET_KEY=replace_with_click_secret_key

# Firebase Admin SDK uses Application Default Credentials (ADC). In Google Cloud,
# prefer the workload service account. Outside Google Cloud, securely mount a
# service-account key file and point GOOGLE_APPLICATION_CREDENTIALS to it.
FIREBASE_PROJECT_ID=replace_with_firebase_project_id
GOOGLE_APPLICATION_CREDENTIALS=./secrets/firebase-service-account.json

# No SMS provider is configured by default. Configure a real provider in the
# deployment environment before enabling phone OTP in production.
